# ==============================================================================
# Variáveis de Ambiente - Catálogo de Filmes e Microsserviço de Autenticação
# Copie este arquivo como .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# Porta do Servidor HTTP Público (Catálogo)
PORT=3000

# URL interna do Microsserviço de Autenticação (dentro da rede Docker)
AUTH_SERVICE_URL=http://auth-service:4000

# URL pública da aplicação (usada para montar o link do e-mail de recuperação de senha)
APP_URL=http://localhost:3000

# Chave de API da TMDB (The Movie Database)
# Obtenha gratuitamente em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_api_tmdb_aqui

# Configurações de Conexão com o MariaDB
DB_HOST=mariadb
DB_PORT=3306
DB_USER=usuario_aluno
DB_PASSWORD=senha_aluno
DB_NAME=catalogo_filmes

# Segredo compartilhado para assinatura e validação dos tokens JWT
JWT_SECRET=seu_segredo_jwt_super_seguro_e_aleatorio

# ==============================================================================
# Configurações do Serviço de E-mail (SMTP)
# Dev: Mailtrap (sandbox.smtp.mailtrap.io | porta 2525)
# Prod: Brevo (smtp-relay.brevo.com | porta 587)
# ==============================================================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu_usuario_mailtrap
SMTP_PASS=sua_senha_mailtrap
SMTP_FROM="Catálogo de Filmes <nao-responda@catalogofilmes.com>"
